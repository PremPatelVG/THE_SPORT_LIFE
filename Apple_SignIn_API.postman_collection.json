          "raw": "{\n  \"identityToken\": \"eyJraWQiOiJlWGF1bm1MIiwiYWxnIjoiUlMyNTYifQ.eyJpc3MiOiJodHRwczovL2FwcGxlaWQuYXBwbGUuY29tIiwiYXVkIjoiY29tLnlvdXJhcHAuYnVuZGxlaWQiLCJleHAiOjE3MzMxNDU2MDAsImlhdCI6MTczMzA1OTIwMCwic3ViIjoiMDAxMjM0LjU2Nzg5MGFiY2RlZi4xMjM0IiwiZW1haWwiOiJ0ZXN0dXNlckBwcml2YXRlcmVsYXkuYXBwbGVpZC5jb20iLCJlbWFpbF92ZXJpZmllZCI6InRydWUifQ.signature\",\n  \"userInfo\": {\n    \"email\": \"testuser@privaterelay.appleid.com\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/auth/apple",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "auth", "apple"]
        },
        "description": "Test login for existing Apple user. Should return user data and tokens immediately."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
