        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appleId\": \"001234.567890abcdef.1234\",\n  \"email\": \"testuser@privaterelay.appleid.com\",\n  \"phone\": \"+919876543210\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"gender\": \"male\",\n  \"date_of_birth\": \"1990-01-15\",\n  \"handedness\": \"right\",\n  \"sport_interests\": [\n    {\n      \"sport_id\": 1,\n      \"skill_level\": \"intermediate\"\n    },\n    {\n      \"sport_id\": 3,\n      \"skill_level\": \"beginner\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/auth/complete-apple-registration",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "auth", "complete-apple-registration"]
        },
        "description": "Complete Apple registration with all optional fields including sport interests."
      },
      "response": []
    },
