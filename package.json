{
  "name": "sportlife-backend",
  "version": "1.0.0",
  "description": "Complete backend for SportLife - Multi-sport tournament management and live scoring system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "setup": "./setup.sh",
    "db:setup": "./scripts/db-setup.sh",
    "db:reset": "mysql -u root -p -e \"DROP DATABASE IF EXISTS sportlife; CREATE DATABASE sportlife CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\" && ./scripts/db-setup.sh"
  },
  "keywords": [
    "sports",
    "tournament",
    "scoring",
    "tennis",
    "badminton",
    "football",
    "volleyball"
  ],
  "author": "SportLife Team",
  "license": "MIT",
  "dependencies": {
    "apple-signin-auth": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.10.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^6.9.5",
    "socket.io": "^4.7.2",
    "stripe": "^13.5.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
