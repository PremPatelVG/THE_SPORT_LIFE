import { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import Navbar from '../components/Navbar';
import {
  Mail,
  CheckCircle,
  XCircle,
  Calendar,
  MapPin,
  Trophy,
  Users,
  Loader,
  AlertCircle,
  Clock,
  Info,
  Award,
  ArrowLeft,
  User
} from 'lucide-react';
import api from '../config/api';

const InvitationDetails = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [invitation, setInvitation] = useState(null);
  const [loading, setLoading] = useState(true);
  const [processing, setProcessing] = useState(false);
  const [viewMode, setViewMode] = useState(null); // 'tournament' or 'referee'

  useEffect(() => {
    fetchInvitationDetails();
  }, [id]);

  const fetchInvitationDetails = async () => {
    try {
      setLoading(true);
      
      // Try fetching as tournament invitation first
      try {
        const response = await api.get('/registrations/my-invitations');
        const tournamentInvitation = response.data.data.find(inv => inv.id === parseInt(id));
        
        if (tournamentInvitation) {
          setInvitation(tournamentInvitation);
          setViewMode('tournament');
          setLoading(false);
          return;
        }
      } catch (error) {
        console.log('Not a tournament invitation');
      }

      // Try fetching as referee invitation
      try {
        const authResponse = await api.get('/auth/profile');
        const userId = authResponse.data.data.id;
        const response = await api.get(`/referees/${userId}/requests`);
        const refereeInvitation = response.data.data.find(inv => inv.id === parseInt(id));
        
        if (refereeInvitation) {
          setInvitation(refereeInvitation);
          setViewMode('referee');
          setLoading(false);
          return;
        }
      } catch (error) {
        console.log('Not a referee invitation');
      }

      // If not found in either
      throw new Error('Invitation not found');
      
    } catch (error) {
      console.error('Failed to fetch invitation details:', error);
      alert('Invitation not found');
      navigate('/tournaments/invitations');
    } finally {
      setLoading(false);
    }
  };

  const handleRespond = async (accept) => {
    try {
      setProcessing(true);
      
      if (viewMode === 'tournament') {
        await api.put(`/registrations/invitations/${id}/respond`, {
          accept
        });
      } else {
        await api.post(`/referees/requests/${id}/respond`, {
          response: accept ? 'accepted' : 'declined'
        });
      }
      
      alert(accept ? 'Invitation accepted successfully!' : 'Invitation declined');
      navigate('/tournaments/invitations');
      
    } catch (error) {
      console.error('Failed to respond to invitation:', error);
      alert(error.response?.data?.message || 'Failed to respond to invitation');
    } finally {
      setProcessing(false);
    }
  };

  const getStatusBadge = (status) => {
    const config = {
      pending: { bg: 'bg-yellow-100', text: 'text-yellow-700', label: 'Pending', icon: Clock },
      accepted: { bg: 'bg-emerald-100', text: 'text-emerald-700', label: 'Accepted', icon: CheckCircle },
      declined: { bg: 'bg-red-100', text: 'text-red-700', label: 'Declined', icon: XCircle },
      locked: { bg: 'bg-blue-100', text: 'text-blue-700', label: 'Confirmed', icon: CheckCircle }
    };

    const statusInfo = config[status] || config.pending;
    const Icon = statusInfo.icon;

    return (
      <span className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-semibold ${statusInfo.bg} ${statusInfo.text}`}>
        <Icon className="w-4 h-4" />
        {statusInfo.label}
      </span>
    );
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Navbar />
        <div className="flex items-center justify-center h-96">
          <Loader className="w-8 h-8 animate-spin text-emerald-600" />
        </div>
      </div>
    );
  }

  if (!invitation) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Navbar />
        <div className="max-w-4xl mx-auto px-4 py-8">
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-12 text-center">
            <AlertCircle className="w-16 h-16 text-red-500 mx-auto mb-4" />
            <h3 className="text-xl font-bold text-gray-900 mb-2">Invitation Not Found</h3>
            <p className="text-gray-600 mb-6">The invitation you're looking for doesn't exist or has been removed.</p>
            <button
              onClick={() => navigate('/tournaments/invitations')}
              className="px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200"
            >
              Back to Invitations
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      <Navbar />

      <div className="max-w-4xl mx-auto px-4 py-4">
        {/* Back Button */}
        <button
          onClick={() => navigate('/tournaments/invitations')}
          className="mb-4 flex items-center gap-2 text-gray-600 hover:text-emerald-600 transition-colors text-sm"
        >
          <ArrowLeft className="w-4 h-4" />
          <span className="font-semibold">Back to Invitations</span>
        </button>

        {/* Header */}
        <div className="mb-4">
          <div className="flex items-center gap-2 mb-1">
            {viewMode === 'tournament' ? (
              <Trophy className="w-6 h-6 text-emerald-600" />
            ) : (
              <Award className="w-6 h-6 text-emerald-600" />
            )}
            <h1 className="text-2xl font-bold text-gray-900">
              {viewMode === 'tournament' ? 'Tournament Invitation' : 'Referee Assignment'}
            </h1>
          </div>
          <p className="text-sm text-gray-600">
            Review the details and respond to this {viewMode === 'tournament' ? 'invitation' : 'assignment'}
          </p>
        </div>

        {/* Main Card */}
        <div className="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
          {/* Header Section */}
          <div className="bg-gradient-to-br from-emerald-500 to-teal-600 p-5 text-white">
            <div className="flex items-start justify-between mb-2">
              <div className="flex-1">
                <h2 className="text-2xl font-bold mb-2">{invitation.tournament_name}</h2>
                <div className="flex flex-wrap items-center gap-3 text-sm">
                  <div className="flex items-center gap-2">
                    <Trophy className="w-5 h-5" />
                    <span className="font-semibold">{invitation.sport_name}</span>
                  </div>
                  {viewMode === 'tournament' ? (
                    <div className="flex items-center gap-2">
                      <Calendar className="w-5 h-5" />
                      <span>
                        {new Date(invitation.start_date).toLocaleDateString()} - {new Date(invitation.end_date).toLocaleDateString()}
                      </span>
                    </div>
                  ) : (
                    invitation.match_date && (
                      <div className="flex items-center gap-2">
                        <Calendar className="w-5 h-5" />
                        <span>{new Date(invitation.match_date).toLocaleDateString()}</span>
                        {invitation.match_time && <span>• {invitation.match_time}</span>}
                      </div>
                    )
                  )}
                  {invitation.venue_name && (
                    <div className="flex items-center gap-2">
                      <MapPin className="w-5 h-5" />
                      <span>{invitation.venue_name}</span>
                      {invitation.court_name && <span>• {invitation.court_name}</span>}
                    </div>
                  )}
                </div>
              </div>
              <div>
                {getStatusBadge(invitation.status)}
              </div>
            </div>
          </div>

          {/* Content Section */}
          <div className="p-5">
            {/* Message from Organizer */}
            {invitation.notes && (
              <div className="mb-5 p-4 bg-blue-50 border-l-4 border-blue-500 rounded-lg">
                <div className="flex items-start gap-2">
                  <Info className="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
                  <div className="flex-1">
                    <p className="text-xs font-semibold text-blue-900 mb-1">
                      Message from {viewMode === 'tournament' ? 'Organizer' : 'Assigner'}:
                    </p>
                    <p className="text-sm text-blue-800">{invitation.notes}</p>
                  </div>
                </div>
              </div>
            )}

            {/* Details Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
              {/* Sport */}
              <div className="p-4 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-lg border border-emerald-200">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 bg-emerald-500 rounded-lg flex items-center justify-center">
                    <Trophy className="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <p className="text-xs text-gray-600 font-semibold">Sport</p>
                    <p className="text-lg font-bold text-gray-900">{invitation.sport_name}</p>
                  </div>
                </div>
              </div>

              {/* Date */}
              <div className="p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg border border-blue-200">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                    <Calendar className="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <p className="text-xs text-gray-600 font-semibold">
                      {viewMode === 'tournament' ? 'Tournament Dates' : 'Match Date'}
                    </p>
                    <p className="text-lg font-bold text-gray-900">
                      {viewMode === 'tournament' 
                        ? `${new Date(invitation.start_date).toLocaleDateString()}`
                        : invitation.match_date 
                          ? new Date(invitation.match_date).toLocaleDateString()
                          : 'TBD'
                      }
                    </p>
                    {viewMode === 'tournament' && (
                      <p className="text-xs text-gray-600">to {new Date(invitation.end_date).toLocaleDateString()}</p>
                    )}
                    {viewMode === 'referee' && invitation.match_time && (
                      <p className="text-xs text-gray-600">at {invitation.match_time}</p>
                    )}
                  </div>
                </div>
              </div>

              {/* Venue */}
              {invitation.venue_name && (
                <div className="p-4 bg-gradient-to-br from-purple-50 to-pink-50 rounded-lg border border-purple-200">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center">
                      <MapPin className="w-5 h-5 text-white" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-600 font-semibold">Venue</p>
                      <p className="text-lg font-bold text-gray-900">{invitation.venue_name}</p>
                      {invitation.court_name && (
                        <p className="text-xs text-gray-600">{invitation.court_name}</p>
                      )}
                    </div>
                  </div>
                </div>
              )}

              {/* Organizer/Assigner */}
              {(invitation.organizer_name || invitation.assigned_by_first_name) && (
                <div className="p-4 bg-gradient-to-br from-orange-50 to-yellow-50 rounded-lg border border-orange-200">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center">
                      <User className="w-5 h-5 text-white" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-600 font-semibold">
                        {viewMode === 'tournament' ? 'Organizer' : 'Assigned By'}
                      </p>
                      <p className="text-lg font-bold text-gray-900">
                        {viewMode === 'tournament' 
                          ? invitation.organizer_name 
                          : `${invitation.assigned_by_first_name} ${invitation.assigned_by_last_name}`
                        }
                      </p>
                    </div>
                  </div>
                </div>
              )}
            </div>

            {/* Invitation Info */}
            <div className="p-4 bg-gray-50 rounded-lg mb-5">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-xs text-gray-600 font-semibold mb-1">
                    {viewMode === 'tournament' ? 'Invited On' : 'Assigned On'}
                  </p>
                  <p className="text-sm font-bold text-gray-900">
                    {new Date(viewMode === 'tournament' ? invitation.requested_at : invitation.assigned_at).toLocaleString()}
                  </p>
                </div>
                <div className="text-right">
                  <p className="text-xs text-gray-600 font-semibold mb-1">Status</p>
                  <p className="text-sm font-bold text-gray-900 capitalize">{invitation.status}</p>
                </div>
              </div>
            </div>

            {/* Action Buttons */}
            {invitation.status === 'pending' ? (
              <div className="space-y-3">
                <div className="flex gap-3">
                  <button
                    onClick={() => handleRespond(true)}
                    disabled={processing}
                    className="flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    {processing ? (
                      <Loader className="w-5 h-5 animate-spin" />
                    ) : (
                      <>
                        <CheckCircle className="w-5 h-5" />
                        Accept {viewMode === 'tournament' ? 'Invitation' : 'Assignment'}
                      </>
                    )}
                  </button>
                  <button
                    onClick={() => handleRespond(false)}
                    disabled={processing}
                    className="flex-1 flex items-center justify-center gap-2 px-6 py-3 border-2 border-red-600 text-red-600 font-bold rounded-lg hover:bg-red-50 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    {processing ? (
                      <Loader className="w-5 h-5 animate-spin" />
                    ) : (
                      <>
                        <XCircle className="w-5 h-5" />
                        Decline
                      </>
                    )}
                  </button>
                </div>
                <p className="text-center text-xs text-gray-500">
                  Please review all details carefully before responding
                </p>
              </div>
            ) : (
              <div>
                {invitation.status === 'accepted' && (
                  <div className="p-4 bg-emerald-50 border-2 border-emerald-200 rounded-lg text-center">
                    <CheckCircle className="w-10 h-10 text-emerald-600 mx-auto mb-2" />
                    <p className="text-emerald-800 font-bold">
                      You have accepted this {viewMode === 'tournament' ? 'invitation' : 'assignment'}
                    </p>
                  </div>
                )}

                {invitation.status === 'locked' && (
                  <div className="p-4 bg-blue-50 border-2 border-blue-200 rounded-lg text-center">
                    <CheckCircle className="w-10 h-10 text-blue-600 mx-auto mb-2" />
                    <p className="text-blue-800 font-bold">
                      Your participation is confirmed
                    </p>
                  </div>
                )}

                {invitation.status === 'declined' && (
                  <div className="p-4 bg-red-50 border-2 border-red-200 rounded-lg text-center">
                    <XCircle className="w-10 h-10 text-red-600 mx-auto mb-2" />
                    <p className="text-red-800 font-bold">
                      You declined this {viewMode === 'tournament' ? 'invitation' : 'assignment'}
                    </p>
                  </div>
                )}
              </div>
            )}

            {/* View Tournament Button */}
            <button
              onClick={() => navigate(`/tournaments/${invitation.tournament_id}`)}
              className="w-full mt-4 px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 hover:border-emerald-500 hover:text-emerald-600 transition-all"
            >
              View Tournament Details
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default InvitationDetails;
