import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import Navbar from '../components/Navbar';
import {
  Mail,
  CheckCircle,
  XCircle,
  Calendar,
  MapPin,
  Trophy,
  Users,
  Loader,
  AlertCircle,
  Clock,
  Info,
  Award
} from 'lucide-react';
import api from '../config/api';

const TournamentInvitations = () => {
  const navigate = useNavigate();
  const [invitations, setInvitations] = useState([]);
  const [loading, setLoading] = useState(true);
  const [viewMode, setViewMode] = useState('tournament'); // 'tournament' or 'referee'

  useEffect(() => {
    if (viewMode === 'tournament') {
      fetchInvitations();
    } else {
      fetchRefereeInvitations();
    }
  }, [viewMode]);

  const fetchInvitations = async () => {
    try {
      setLoading(true);
      const response = await api.get('/registrations/my-invitations');
      setInvitations(response.data.data || []);
    } catch (error) {
      console.error('Failed to fetch invitations:', error);
    } finally {
      setLoading(false);
    }
  };

  const fetchRefereeInvitations = async () => {
    try {
      setLoading(true);
      // Get current user ID from auth
      const authResponse = await api.get('/auth/profile');
      const userId = authResponse.data.data.id;
      
      // Fetch referee assignment requests
      const response = await api.get(`/referees/${userId}/requests`);
      setInvitations(response.data.data || []);
    } catch (error) {
      console.error('Failed to fetch referee invitations:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleViewDetails = (invitationId) => {
    navigate(`/tournaments/invitations/${invitationId}`);
  };

  const getStatusBadge = (status) => {
    const config = {
      pending: { bg: 'bg-yellow-100', text: 'text-yellow-700', label: 'Pending', icon: Clock },
      accepted: { bg: 'bg-emerald-100', text: 'text-emerald-700', label: 'Accepted', icon: CheckCircle },
      declined: { bg: 'bg-red-100', text: 'text-red-700', label: 'Declined', icon: XCircle },
      locked: { bg: 'bg-blue-100', text: 'text-blue-700', label: 'Confirmed', icon: CheckCircle }
    };

    const statusInfo = config[status] || config.pending;
    const Icon = statusInfo.icon;

    return (
      <span className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-semibold ${statusInfo.bg} ${statusInfo.text}`}>
        <Icon className="w-4 h-4" />
        {statusInfo.label}
      </span>
    );
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Navbar />
        <div className="flex items-center justify-center h-96">
          <Loader className="w-8 h-8 animate-spin text-emerald-600" />
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      <Navbar />

      <div className="max-w-7xl mx-auto px-4 py-8">
        {/* Header */}
        <div className="mb-8">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-3xl font-bold text-gray-900 flex items-center gap-3">
                {viewMode === 'tournament' ? (
                  <><Mail className="w-8 h-8 text-emerald-600" />Tournament Invitations</>
                ) : (
                  <><Award className="w-8 h-8 text-emerald-600" />Referee Invitations</>
                )}
              </h1>
              <p className="text-gray-600 mt-2">
                {viewMode === 'tournament' 
                  ? 'Review and respond to tournament invitations'
                  : 'Review and respond to referee assignment requests'
                }
              </p>
            </div>
            
            {/* Toggle Switch */}
            <div className="flex items-center gap-2 bg-white rounded-lg shadow-md p-1 border border-gray-200">
              <button
                onClick={() => setViewMode('tournament')}
                className={`px-4 py-2 rounded-md font-semibold transition-all ${
                  viewMode === 'tournament'
                    ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-md'
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <div className="flex items-center gap-2">
                  <Trophy className="w-4 h-4" />
                  Tournament
                </div>
              </button>
              <button
                onClick={() => setViewMode('referee')}
                className={`px-4 py-2 rounded-md font-semibold transition-all ${
                  viewMode === 'referee'
                    ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-md'
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <div className="flex items-center gap-2">
                  <Award className="w-4 h-4" />
                  Match official
                </div>
              </button>
            </div>
          </div>
        </div>

        {/* Stats */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div className="bg-white rounded-lg shadow-sm p-6 border-l-4 border-yellow-500">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Pending</p>
                <p className="text-3xl font-bold text-gray-900">
                  {invitations.filter(i => i.status === 'pending').length}
                </p>
              </div>
              <Clock className="w-10 h-10 text-yellow-500" />
            </div>
          </div>

          <div className="bg-white rounded-lg shadow-sm p-6 border-l-4 border-emerald-500">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Accepted</p>
                <p className="text-3xl font-bold text-gray-900">
                  {invitations.filter(i => i.status === 'accepted' || i.status === 'locked').length}
                </p>
              </div>
              <CheckCircle className="w-10 h-10 text-emerald-500" />
            </div>
          </div>

          <div className="bg-white rounded-lg shadow-sm p-6 border-l-4 border-gray-500">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Total</p>
                <p className="text-3xl font-bold text-gray-900">
                  {invitations.length}
                </p>
              </div>
              <Mail className="w-10 h-10 text-gray-500" />
            </div>
          </div>
        </div>

        {/* Invitations List */}
        {invitations.length === 0 ? (
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-12 text-center">
            <div className="w-20 h-20 bg-gradient-to-br from-gray-100 to-gray-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <Mail className="w-10 h-10 text-gray-400" />
            </div>
            <h3 className="text-xl font-bold text-gray-900 mb-2">No Invitations</h3>
            <p className="text-gray-600 mb-6">You don't have any tournament invitations yet</p>
            <button
              onClick={() => navigate('/tournaments')}
              className="px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 inline-flex items-center gap-2"
            >
              <Trophy className="w-5 h-5" />
              Browse Tournaments
            </button>
          </div>
        ) : (
          <div className="space-y-6">
            {invitations.map((invitation) => (
              <div
                key={invitation.id}
                className="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow"
              >
                {/* Header */}
                <div className="bg-gradient-to-br from-emerald-500 to-teal-600 p-6 text-white">
                  <div className="flex items-start justify-between">
                    <div className="flex-1">
                      <h3 className="text-2xl font-bold mb-2">{invitation.tournament_name}</h3>
                      <div className="flex flex-wrap items-center gap-4 text-sm">
                        <div className="flex items-center gap-2">
                          <Trophy className="w-4 h-4" />
                          <span>{invitation.sport_name}</span>
                        </div>
                        {viewMode === 'tournament' ? (
                          <>
                            <div className="flex items-center gap-2">
                              <Calendar className="w-4 h-4" />
                              <span>
                                {new Date(invitation.start_date).toLocaleDateString()} - {new Date(invitation.end_date).toLocaleDateString()}
                              </span>
                            </div>
                            {invitation.venue_name && (
                              <div className="flex items-center gap-2">
                                <MapPin className="w-4 h-4" />
                                <span>{invitation.venue_name}</span>
                              </div>
                            )}
                          </>
                        ) : (
                          <>
                            {invitation.match_date && (
                              <div className="flex items-center gap-2">
                                <Calendar className="w-4 h-4" />
                                <span>{new Date(invitation.match_date).toLocaleDateString()}</span>
                                {invitation.match_time && <span>• {invitation.match_time}</span>}
                              </div>
                            )}
                            {invitation.venue_name && (
                              <div className="flex items-center gap-2">
                                <MapPin className="w-4 h-4" />
                                <span>{invitation.venue_name}</span>
                                {invitation.court_name && <span>• {invitation.court_name}</span>}
                              </div>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                    <div>
                      {getStatusBadge(invitation.status)}
                    </div>
                  </div>
                </div>

                {/* Content */}
                <div className="p-6">
                  {/* Invitation Message */}
                  {invitation.notes && (
                    <div className="mb-6 p-4 bg-blue-50 border-l-4 border-blue-500 rounded">
                      <div className="flex items-start gap-3">
                        <Info className="w-5 h-5 text-blue-600 mt-0.5" />
                        <div>
                          <p className="text-sm font-semibold text-blue-900 mb-1">Message from Organizer:</p>
                          <p className="text-sm text-blue-800">{invitation.notes}</p>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Details */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                      <div className="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                        <Trophy className="w-5 h-5 text-emerald-600" />
                      </div>
                      <div>
                        <p className="text-xs text-gray-600">Sport</p>
                        <p className="font-semibold text-gray-900">{invitation.sport_name}</p>
                      </div>
                    </div>

                    <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                      <div className="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                        <Calendar className="w-5 h-5 text-blue-600" />
                      </div>
                      <div>
                        <p className="text-xs text-gray-600">
                          {viewMode === 'tournament' ? 'Start Date' : 'Match Date'}
                        </p>
                        <p className="font-semibold text-gray-900">
                          {viewMode === 'tournament' 
                            ? new Date(invitation.start_date).toLocaleDateString()
                            : invitation.match_date 
                              ? new Date(invitation.match_date).toLocaleDateString()
                              : 'TBD'
                          }
                        </p>
                      </div>
                    </div>

                    {invitation.venue_name && (
                      <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                        <div className="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                          <MapPin className="w-5 h-5 text-purple-600" />
                        </div>
                        <div>
                          <p className="text-xs text-gray-600">Venue</p>
                          <p className="font-semibold text-gray-900">{invitation.venue_name}</p>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Invitation Info */}
                  <div className="flex items-center justify-between p-4 bg-gray-50 rounded-lg mb-6">
                    <div>
                      <p className="text-sm text-gray-600">
                        {viewMode === 'tournament' ? 'Invited on' : 'Assigned on'}
                      </p>
                      <p className="font-semibold text-gray-900">
                        {new Date(viewMode === 'tournament' ? invitation.requested_at : invitation.assigned_at).toLocaleString()}
                      </p>
                    </div>
                    {(invitation.organizer_name || invitation.assigned_by_first_name) && (
                      <div className="text-right">
                        <p className="text-sm text-gray-600">
                          {viewMode === 'tournament' ? 'Organizer' : 'Assigned by'}
                        </p>
                        <p className="font-semibold text-gray-900">
                          {viewMode === 'tournament' 
                            ? invitation.organizer_name 
                            : `${invitation.assigned_by_first_name} ${invitation.assigned_by_last_name}`
                          }
                        </p>
                      </div>
                    )}
                  </div>

                  {/* Status Messages */}
                  {invitation.status === 'accepted' && (
                    <div className="p-4 bg-emerald-50 border border-emerald-200 rounded-lg text-center mb-4">
                      <p className="text-emerald-800 font-semibold">
                        ✓ You have accepted this invitation
                      </p>
                    </div>
                  )}

                  {invitation.status === 'locked' && (
                    <div className="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center mb-4">
                      <p className="text-blue-800 font-semibold">
                        ✓ Your participation is confirmed
                      </p>
                    </div>
                  )}

                  {invitation.status === 'declined' && (
                    <div className="p-4 bg-red-50 border border-red-200 rounded-lg text-center mb-4">
                      <p className="text-red-800 font-semibold">
                        You declined this invitation
                      </p>
                    </div>
                  )}

                  {/* View Invitation Details Button */}
                  <button
                    onClick={() => handleViewDetails(invitation.id)}
                    className="w-full px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2"
                  >
                    <Info className="w-5 h-5" />
                    View Invitation Details
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};

export default TournamentInvitations;
