import { useState, useEffect } from 'react';
import {
  CheckCircle,
  XCircle,
  Loader,
  AlertCircle,
  Calendar,
  MapPin,
  Users,
  Trophy,
  Eye,
  Clock
} from 'lucide-react';
import adminApi from '../../config/adminApi';

const TournamentApprovals = () => {
  const [tournaments, setTournaments] = useState([]);
  const [loading, setLoading] = useState(true);
  const [processing, setProcessing] = useState(null);
  const [error, setError] = useState('');

  useEffect(() => {
    fetchPendingApprovals();
  }, []);

  const fetchPendingApprovals = async () => {
    try {
      setLoading(true);
      const response = await adminApi.get('/tournaments/pending');
      setTournaments(response.data.data || []);
    } catch (err) {
      console.error('Failed to fetch pending approvals:', err);
      setError('Failed to load pending approvals');
    } finally {
      setLoading(false);
    }
  };

  const handleApprove = async (tournamentId) => {
    if (!window.confirm('Are you sure you want to approve this tournament?')) {
      return;
    }

    try {
      setProcessing(tournamentId);
      await adminApi.post(`/tournaments/${tournamentId}/approve`);
      alert('Tournament approved successfully!');
      fetchPendingApprovals();
    } catch (err) {
      console.error('Failed to approve tournament:', err);
      alert(err.response?.data?.error || 'Failed to approve tournament');
    } finally {
      setProcessing(null);
    }
  };

  const handleReject = async (tournamentId) => {
    const reason = prompt('Enter rejection reason (optional):');
    
    if (reason === null) return; // User cancelled

    try {
      setProcessing(tournamentId);
      await adminApi.post(`/tournaments/${tournamentId}/reject`, { reason });
      alert('Tournament rejected');
      fetchPendingApprovals();
    } catch (err) {
      console.error('Failed to reject tournament:', err);
      alert(err.response?.data?.error || 'Failed to reject tournament');
    } finally {
      setProcessing(null);
    }
  };

  const formatDate = (dateString) => {
    if (!dateString) return 'N/A';
    return new Date(dateString).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-96">
        <Loader className="w-8 h-8 animate-spin text-blue-600" />
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-50 border border-red-200 rounded-lg p-6 flex items-start gap-3">
        <AlertCircle className="w-6 h-6 text-red-600 flex-shrink-0" />
        <div>
          <h3 className="font-semibold text-red-900">Error</h3>
          <p className="text-red-700">{error}</p>
        </div>
      </div>
    );
  }

  if (tournaments.length === 0) {
    return (
      <div className="bg-white rounded-xl shadow-sm p-12 text-center">
        <CheckCircle className="w-16 h-16 text-green-500 mx-auto mb-4" />
        <h3 className="text-xl font-bold text-gray-900 mb-2">All Caught Up!</h3>
        <p className="text-gray-600">No pending tournament approvals at the moment.</p>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
        <div className="flex items-center justify-between">
          <div>
            <h2 className="text-2xl font-bold text-gray-900">Pending Approvals</h2>
            <p className="text-gray-600 mt-1">{tournaments.length} tournament(s) awaiting review</p>
          </div>
          <div className="flex items-center gap-2 bg-yellow-100 text-yellow-800 px-4 py-2 rounded-lg">
            <Clock className="w-5 h-5" />
            <span className="font-semibold">{tournaments.length} Pending</span>
          </div>
        </div>
      </div>

      {/* Tournaments List */}
      <div className="space-y-4">
        {tournaments.map((tournament) => (
          <div
            key={tournament.id}
            className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow"
          >
            <div className="p-6">
              <div className="flex items-start justify-between mb-4">
                <div className="flex-1">
                  <div className="flex items-center gap-3 mb-2">
                    <h3 className="text-xl font-bold text-gray-900">{tournament.name}</h3>
                    <span className="px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded-full">
                      Pending Approval
                    </span>
                  </div>
                  {tournament.description && (
                    <p className="text-gray-600 text-sm mb-3">{tournament.description}</p>
                  )}
                </div>
              </div>

              {/* Tournament Details Grid */}
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <div className="flex items-center gap-2 text-sm">
                  <Trophy className="w-4 h-4 text-blue-600" />
                  <span className="text-gray-600">Sport:</span>
                  <span className="font-medium text-gray-900">{tournament.sport_name}</span>
                </div>

                <div className="flex items-center gap-2 text-sm">
                  <Calendar className="w-4 h-4 text-green-600" />
                  <span className="text-gray-600">Date:</span>
                  <span className="font-medium text-gray-900">
                    {formatDate(tournament.start_date)}
                  </span>
                </div>

                <div className="flex items-center gap-2 text-sm">
                  <MapPin className="w-4 h-4 text-red-600" />
                  <span className="text-gray-600">Venue:</span>
                  <span className="font-medium text-gray-900">{tournament.venue_name}</span>
                </div>

                <div className="flex items-center gap-2 text-sm">
                  <Users className="w-4 h-4 text-purple-600" />
                  <span className="text-gray-600">Category:</span>
                  <span className="font-medium text-gray-900 capitalize">{tournament.category}</span>
                </div>
              </div>

              {/* Organizer Info */}
              <div className="bg-gray-50 rounded-lg p-4 mb-4">
                <p className="text-sm text-gray-600 mb-1">Organizer</p>
                <p className="font-semibold text-gray-900">
                  {tournament.organizer_first_name} {tournament.organizer_last_name}
                </p>
                <p className="text-sm text-gray-600">{tournament.organizer_email}</p>
                {tournament.organizer_phone && (
                  <p className="text-sm text-gray-600">{tournament.organizer_phone}</p>
                )}
              </div>

              {/* Action Buttons */}
              <div className="flex items-center gap-3">
                <button
                  onClick={() => window.open(`/tournaments/${tournament.id}`, '_blank')}
                  className="flex items-center gap-2 px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors"
                >
                  <Eye className="w-4 h-4" />
                  View Full Details
                </button>

                <button
                  onClick={() => handleApprove(tournament.id)}
                  disabled={processing === tournament.id}
                  className="flex items-center gap-2 px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {processing === tournament.id ? (
                    <Loader className="w-4 h-4 animate-spin" />
                  ) : (
                    <CheckCircle className="w-4 h-4" />
                  )}
                  Approve
                </button>

                <button
                  onClick={() => handleReject(tournament.id)}
                  disabled={processing === tournament.id}
                  className="flex items-center gap-2 px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <XCircle className="w-4 h-4" />
                  Reject
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

export default TournamentApprovals;
