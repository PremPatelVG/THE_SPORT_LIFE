import { useState, useEffect } from 'react';
import { Trophy, Circle, Clock, RefreshCw, Undo, ArrowLeftRight, AlertCircle, CheckCircle, XCircle } from 'lucide-react';
import { getServingIcon } from '../../utils/sportIcons';
import api from '../../config/api';

/**
 * Set-Based Scoring Interface
 * Handles: Badminton, Tennis, Pickleball, Padel
 * 
 * Scoring Systems:
 * - Tennis/Padel: 0-15-30-40-Game, Sets, Tiebreaks
 * - Badminton: 0-21 Rally scoring, Sets (Best of 3)
 * - Pickleball: 0-11 Rally scoring, Games (Best of 3)
 */
const SetBasedScoringInterface = ({ match, liveScore, sport, onAddPoint, onToggleServer, onUndo }) => {
  const [showConfirmation, setShowConfirmation] = useState(false);
  const [pendingPoint, setPendingPoint] = useState(null);
  const [isSwapped, setIsSwapped] = useState(false);
  const [showMatchEndConfirmation, setShowMatchEndConfirmation] = useState(false);
  const [confirmingMatchEnd, setConfirmingMatchEnd] = useState(false);
  const [isDeuceBlinking, setIsDeuceBlinking] = useState(false);
  
  // Check if match end confirmation is needed
  useEffect(() => {
    if (liveScore?.awaiting_match_end_confirmation) {
      setShowMatchEndConfirmation(true);
    } else {
      setShowMatchEndConfirmation(false);
    }
  }, [liveScore?.awaiting_match_end_confirmation]);

  // Trigger blink animation when deuce happens
  useEffect(() => {
    const currentSetIndex = (liveScore?.current_set || 1) - 1;
    
    const p1Score = liveScore?.participant1?.set_scores?.[currentSetIndex] || 0;
    const p2Score = liveScore?.participant2?.set_scores?.[currentSetIndex] || 0;
    const isCurrentlyTied = p1Score === p2Score;
    
    // Only blink if deuce count > 0 AND scores are currently tied
    if (liveScore?.current_game_deuce_count > 0 && isCurrentlyTied) {
      setIsDeuceBlinking(true);
      const timer = setTimeout(() => setIsDeuceBlinking(false), 3000); // Blink for 3 seconds
      return () => clearTimeout(timer);
    } else {
      // Turn off blinking immediately if not in deuce anymore
      setIsDeuceBlinking(false);
    }
  }, [liveScore?.current_game_deuce_count, liveScore?.participant1, liveScore?.participant2]);

  // Swap participants if isSwapped is true
  const participant1 = isSwapped ? match.participant2_details : match.participant1_details;
  const participant2 = isSwapped ? match.participant1_details : match.participant2_details;
  const participant1Side = isSwapped ? 'participant2' : 'participant1';
  const participant2Side = isSwapped ? 'participant1' : 'participant2';
  
  // Check if match is doubles
  // console.log("======++==", match);
  
  const isDoublesMatch = match.tournament_category === 'doubles' || match.tournament_category === 'Doubles';
  
  // Debug log
  console.log('🔍 Match category check:', {
    category: match.category,
    tournament_category: match.tournament_category,
    isDoublesMatch
  });

  // Determine if sport uses Tennis-style scoring (0-15-30-40) or Rally scoring (0-21)
  const isTennisStyle = ['Tennis', 'Padel'].includes(sport.name);
  const isRallyScoring = ['Badminton', 'Pickleball'].includes(sport.name);
  const isBadminton = sport.name === 'Badminton';
  const isPickleball = sport.name === 'Pickleball';

  /**
   * Get participant name based on category
   */
  const getParticipantName = (details) => {  
    if (!details) return 'Player';
    
    // Singles: user object
    if (details.user) {
      return `${details.user.first_name} ${details.user.last_name}`;
    }
    
    // Doubles: player1 and player2 objects (from backend API)
    if (details.player1 && details.player2) {
      return `${details.player1.first_name} ${details.player1.last_name} / ${details.player2.first_name} ${details.player2.last_name}`;
    }
    
    // Teams: team name
    if (details.team) {
      return details.team.name;
    }
    
    // Fallback to name property if exists
    if (details.name) {
      return details.name;
    }
    
    return 'Player';
  };

  /**
   * Convert numeric points to Tennis/Padel format (ONLY for Tennis/Padel)
   * Regular game: 0 → '0', 1 → '15', 2 → '30', 3 → '40', 4+ → 'Adv'
   * Tiebreak: 0 → '0', 1 → '1', 2 → '2', etc. (numeric)
   */
  const convertToTennisScore = (points, opponentPoints, isTiebreak = false) => {
    if (typeof points !== 'number') {
      // Already in string format (e.g., '0', '15', '30', '40', 'adv')
      return points;
    }

    // In tiebreak mode, use numeric scoring
    if (isTiebreak) {
      return points.toString();
    }

    const scores = ['0', '15', '30', '40'];
    
    // Handle deuce and advantage scenarios (regular game only)
    if (points >= 3 && opponentPoints >= 3) {
      if (points === opponentPoints) {
        return '40'; // Deuce (both at 40)
      } else if (points > opponentPoints) {
        return 'Adv'; // Advantage
      } else {
        return '40'; // Opponent has advantage, show 40
      }
    }
    
    // Normal scoring progression
    if (points < 4) {
      return scores[points];
    }
    
    // If points >= 4 and opponent < 3, game should be won already
    // This shouldn't display, backend should have ended the game
    return '40'; // Fallback (shouldn't reach here in normal flow)
  };

  /**
   * Get current score display based on sport
   */
  const getCurrentScore = (participantSide) => {
    if (!liveScore) return '0';

    const scoreData = liveScore[participantSide];
    const currentIndex = (liveScore.current_set || liveScore.current_game || 1) - 1;
    
    if (isTennisStyle) {
      // Tennis/Padel: Convert numeric points to 15-30-40 format (or numeric in tiebreak)
      const points = scoreData?.current_game_points || 0;
      const opponentSide = participantSide === 'participant1' ? 'participant2' : 'participant1';
      const opponentPoints = liveScore[opponentSide]?.current_game_points || 0;
      const isTiebreak = liveScore.is_tiebreak || false;
      
      return convertToTennisScore(points, opponentPoints, isTiebreak);
    }
    
    if (isBadminton) {
      // Badminton: Show current set score from set_scores array (0-21)
      const setScores = scoreData?.set_scores || [];
      return setScores[currentIndex] || 0;
    }
    
    if (isPickleball) {
      // Pickleball: Show current game score from game_scores array (0-11)
      const gameScores = scoreData?.game_scores || [];
      return gameScores[currentIndex] || 0;
    }
    
    return '0';
  };

  /**
   * Get sets/games won
   */
  const getSetsWon = (participantSide) => {
    if (!liveScore) return 0;
    
    const scoreData = liveScore[participantSide];
    if (!scoreData) return 0;
    
    if (isTennisStyle) {
      return scoreData?.sets_won || 0;
    }
    
    if (isBadminton) {
      return scoreData?.sets_won || 0;  // Badminton uses sets_won
    }
    
    if (isPickleball) {
      return scoreData?.games_won || 0;  // Pickleball uses games_won
    }
    
    return 0;
  };

  /**
   * Get current set/game number
   */
  const getCurrentSetGame = () => {
    if (!liveScore) return 1;
    
    if (isTennisStyle) {
      return liveScore.current_set || 1;
    }
    
    if (isRallyScoring) {
      return liveScore.current_game || 1;
    }
    
    return 1;
  };

  /**
   * Check if participant is serving
   */
  const isServing = (participantSide) => {
    if (!liveScore) return false;
    return liveScore.server === participantSide || liveScore.serving_player === participantSide;
  };

  /**
   * Get server name (handles singles and doubles)
   */
  const getServerName = () => {
    if (!liveScore || !liveScore.server) return 'Unknown';
    
    const serverSide = liveScore.server;
    // Use original match details (not swapped) for server name
    const serverDetails = serverSide === 'participant1' ? match.participant1_details : match.participant2_details;
    
    // For doubles, check if specific player is selected
    console.log("dev====================", isDoublesMatch)
    if (isDoublesMatch && serverDetails && (serverDetails.player1 || serverDetails.player2)) {
      const servingPlayerId = liveScore.serving_player_id;
      
      if (servingPlayerId) {
        // Show specific player name with pair in parentheses
        const player1Id = serverDetails.player1?.id;
        const player2Id = serverDetails.player2?.id;
        
        if (servingPlayerId === player1Id) {
          const playerName = `${serverDetails.player1.first_name} ${serverDetails.player1.last_name}`;
          const pairName = `${serverDetails.player1.first_name} ${serverDetails.player1.last_name} / ${serverDetails.player2.first_name} ${serverDetails.player2.last_name}`;
          return `${playerName} (${pairName})`;
        } else if (servingPlayerId === player2Id) {
          const playerName = `${serverDetails.player2.first_name} ${serverDetails.player2.last_name}`;
          const pairName = `${serverDetails.player1.first_name} ${serverDetails.player1.last_name} / ${serverDetails.player2.first_name} ${serverDetails.player2.last_name}`;
          return `${playerName} (${pairName})`;
        }
      }
    }
    
    return getParticipantName(serverDetails);
  };

  /**
   * Handle server toggle (switches between pairs)
   */
  const handleToggleServer = async () => {
    try {
      if (onToggleServer) {
        await onToggleServer();
      }
    } catch (error) {
      console.error('Failed to toggle server:', error);
      alert('Failed to toggle server: ' + (error.response?.data?.error || error.message));
    }
  };

  /**
   * Handle player selection within same pair (doubles only)
   */
  const handlePlayerSelect = async (playerId) => {
    try {
      if (onToggleServer) {
        // Pass playerId to change serving player within same pair
        await onToggleServer(playerId, true); // true = keep same pair
      }
    } catch (error) {
      console.error('Failed to change serving player:', error);
      alert('Failed to change serving player: ' + (error.response?.data?.error || error.message));
    }
  };

  /**
   * Handle point addition
   */
  const handleAddPoint = async (participantSide) => {
    try {
      await onAddPoint(participantSide, 'point');
      setShowConfirmation(false);
      setPendingPoint(null);
    } catch (error) {
      console.error('Failed to add point:', error);
      alert('Failed to add point: ' + (error.response?.data?.error || error.message));
    }
  };

  /**
   * Handle match end confirmation
   */
  const handleConfirmMatchEnd = async (confirmed) => {
    try {
      setConfirmingMatchEnd(true);
      const response = await api.post(`/matches/${match.id}/score/confirm-end`, {
        confirmed
      });
      
      if (response.data.success) {
        setShowMatchEndConfirmation(false);
        // Refresh page or navigate to match details
        if (confirmed) {
          window.location.reload();
        }
      }
    } catch (error) {
      console.error('Failed to confirm match end:', error);
      alert('Failed to confirm match end: ' + (error.response?.data?.error || error.message));
    } finally {
      setConfirmingMatchEnd(false);
    }
  };

  /**
   * Get score label based on sport
   */
  const getScoreLabel = () => {
    if (isTennisStyle) return 'Sets Won';
    if (isBadminton) return 'Sets Won';  // Badminton uses Sets
    if (isPickleball) return 'Games Won';  // Pickleball uses Games
    return 'Score';
  };

  /**
   * Get current label
   */
  const getCurrentLabel = () => {
    if (isTennisStyle) return `Set ${getCurrentSetGame()}`;
    if (isBadminton) return `Set ${getCurrentSetGame()}`;  // Badminton uses Sets
    if (isPickleball) return `Game ${getCurrentSetGame()}`;  // Pickleball uses Games
    return 'In Progress';
  };

  /**
   * Format Tennis score display (handles Deuce, Advantage)
   */
  const formatTennisScore = (score) => {
    if (score === 'adv' || score === 'Adv') return 'AD';
    return score;
  };

  /**
   * Get games in current set (for Tennis/Padel)
   */
  const getGamesInSet = (participantSide) => {
    if (!liveScore || !isTennisStyle) return 0;
    
    const scoreData = liveScore[participantSide];
    const currentSet = liveScore.current_set || 1;
    
    if (scoreData?.games && scoreData.games[currentSet - 1] !== undefined) {
      return scoreData.games[currentSet - 1];
    }
    
    return 0;
  };

  /**
   * Check if in tiebreak
   */
  const isInTiebreak = () => {
    return liveScore?.is_tiebreak || false;
  };

  return (
    <div>
      {/* Swap Sides Button */}
      <div className="mb-4">
        <button
          onClick={() => setIsSwapped(!isSwapped)}
          className="w-full py-3 bg-gradient-to-r from-teal-500 to-cyan-600 text-white font-bold rounded-lg hover:shadow-lg transition-all flex items-center justify-center gap-2"
        >
          <ArrowLeftRight className="w-5 h-5" />
          SWAP SIDES
        </button>
      </div>
      {/* Scoreboard */}
      <div className={`bg-gradient-to-br from-indigo-600 to-purple-700 rounded-2xl shadow-2xl p-8 mb-6 text-white transition-all ${
        isDeuceBlinking ? 'animate-pulse ring-4 ring-yellow-400 ring-opacity-75' : ''
      }`}>
        <div className="text-center mb-4">
          <div className="inline-block bg-white/20 backdrop-blur-sm px-4 py-1 rounded-full text-sm font-bold">
            {getCurrentLabel()}
            {isInTiebreak() && ' - TIEBREAK'}
          </div>
        </div>

        <div className="flex items-center justify-center gap-12">
          {/* Participant 1 */}
          <div className="flex-1 text-center">
            {/* Sets/Games Won */}
            <div className="text-2xl font-bold mb-2 opacity-90">
              {getScoreLabel()}: {getSetsWon(participant1Side)}
            </div>
            
            {/* Current Score */}
            <div className="text-7xl font-bold mb-3">
              {isTennisStyle ? formatTennisScore(getCurrentScore(participant1Side)) : getCurrentScore(participant1Side)}
            </div>
            
            {/* Games in Set (Tennis only) */}
            {isTennisStyle && !isInTiebreak() && (
              <div className="text-xl opacity-75 mb-2">
                Set {liveScore?.current_set || 1}, Game {getGamesInSet(participant1Side)}
              </div>
            )}
            
            {/* Participant Name */}
            <div className="text-xl font-semibold mb-2">
              {getParticipantName(participant1)}
            </div>
            
            {/* Serving Indicator */}
            <div className="h-8 mt-2 flex items-center justify-center">
              {isServing(participant1Side) && (() => {
                const servingPlayerId = liveScore?.serving_player_id;
                let playerName = null;
                
                // Get specific player name for doubles
                if (isDoublesMatch && participant1?.player1 && participant1?.player2 && servingPlayerId) {
                  const player1Id = participant1.player1?.id;
                  const player2Id = participant1.player2?.id;
                  
                  if (servingPlayerId === player1Id) {
                    playerName = `${participant1.player1.first_name} ${participant1.player1.last_name}`;
                  } else if (servingPlayerId === player2Id) {
                    playerName = `${participant1.player2.first_name} ${participant1.player2.last_name}`;
                  }
                }
                
                return (
                  <div className="inline-flex items-center gap-2 bg-yellow-400 text-gray-900 px-3 py-1 rounded-full text-sm font-bold">
                    <span className="text-lg">{getServingIcon(sport.name)}</span>
                    <span>Serving</span>
                    {playerName && <span>({playerName})</span>}
                  </div>
                );
              })()}
            </div>
          </div>

          {/* VS Divider */}
          <div className="flex flex-col items-center gap-2">
            <div className="text-4xl font-bold opacity-75">VS</div>
            
            {/* Deuce Count for Badminton */}
            {isBadminton && liveScore?.current_game_deuce_count > 0 && (
              <div className="bg-orange-500 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-lg animate-pulse">
                🔥 DEUCE x{liveScore.current_game_deuce_count}
              </div>
            )}
          </div>

          {/* Participant 2 */}
          <div className="flex-1 text-center">
            {/* Sets/Games Won */}
            <div className="text-2xl font-bold mb-2 opacity-90">
              {getScoreLabel()}: {getSetsWon(participant2Side)}
            </div>
            
            {/* Current Score */}
            <div className="text-7xl font-bold mb-3">
              {isTennisStyle ? formatTennisScore(getCurrentScore(participant2Side)) : getCurrentScore(participant2Side)}
            </div>
            
            {/* Games in Set (Tennis only) */}
            {isTennisStyle && !isInTiebreak() && (
              <div className="text-xl opacity-75 mb-2">
                Set {liveScore?.current_set || 1}, Game {getGamesInSet(participant2Side)}
              </div>
            )}
            
            {/* Participant Name */}
            <div className="text-xl font-semibold mb-2">
              {getParticipantName(participant2)}
            </div>
            
            {/* Serving Indicator */}
            <div className="h-8 mt-2 flex items-center justify-center">
              {isServing(participant2Side) && (() => {
                const servingPlayerId = liveScore?.serving_player_id;
                let playerName = null;
                
                // Get specific player name for doubles
                if (isDoublesMatch && participant2?.player1 && participant2?.player2 && servingPlayerId) {
                  const player1Id = participant2.player1?.id;
                  const player2Id = participant2.player2?.id;
                  
                  if (servingPlayerId === player1Id) {
                    playerName = `${participant2.player1.first_name} ${participant2.player1.last_name}`;
                  } else if (servingPlayerId === player2Id) {
                    playerName = `${participant2.player2.first_name} ${participant2.player2.last_name}`;
                  }
                }
                
                return (
                  <div className="inline-flex items-center gap-2 bg-yellow-400 text-gray-900 px-3 py-1 rounded-full text-sm font-bold">
                    <span className="text-lg">{getServingIcon(sport.name)}</span>
                    <span>Serving</span>
                    {playerName && <span>({playerName})</span>}
                  </div>
                );
              })()}
            </div>
          </div>
        </div>

        {/* Deuce/Advantage Indicator */}
        {isTennisStyle && !isInTiebreak() && liveScore?.participant1?.current_game_points >= 3 && liveScore?.participant2?.current_game_points >= 3 && (
          <div className="mt-6 flex justify-center">
            {liveScore.participant1.current_game_points === liveScore.participant2.current_game_points ? (
              <div className="inline-flex items-center gap-2 bg-yellow-400 text-gray-900 px-6 py-3 rounded-full text-lg font-bold shadow-lg animate-pulse">
                <span className="text-2xl">⚡</span>
                <span>DEUCE</span>
                {liveScore.current_game_deuce_count > 0 && (
                  <span className="ml-2 bg-yellow-500 text-white px-3 py-1 rounded-full text-sm">
                    x{liveScore.current_game_deuce_count}
                  </span>
                )}
              </div>
            ) : (
              <div className="inline-flex items-center gap-2 bg-blue-400 text-white px-6 py-3 rounded-full text-lg font-bold shadow-lg">
                <span className="text-2xl">🎯</span>
                <span>ADVANTAGE</span>
                <span className="ml-2 text-sm opacity-90">
                  ({liveScore.participant1.current_game_points > liveScore.participant2.current_game_points ? getParticipantName(participant1) : getParticipantName(participant2)})
                </span>
              </div>
            )}
          </div>
        )}

        {/* Match Info Bar */}
        <div className="mt-6 bg-white/10 backdrop-blur-sm rounded-lg p-4">
          <div className="flex items-center justify-between text-sm">
            <div className="flex items-center gap-2">
              <Trophy className="w-5 h-5" />
              <span className="font-semibold">{sport.name}</span>
            </div>
            <div className="text-center">
              <span className="opacity-90">Best of {isTennisStyle || isBadminton ? '3 Sets' : '3 Games'}</span>
            </div>
            <div className="text-right">
              <span className="font-bold">{match.tournament_category || 'Singles'}</span>
            </div>
          </div>
        </div>
      </div>

      {/* Undo Button - Centered above point buttons */}
      {onUndo && (
        <div className="mb-4">
          <button
            onClick={onUndo}
            className="w-full py-3 bg-gradient-to-r from-red-500 to-red-600 text-white font-bold rounded-lg hover:shadow-lg transition-all flex items-center justify-center gap-2"
          >
            <Undo className="w-5 h-5" />
            UNDO LAST POINT
          </button>
        </div>
      )}

      {/* Point Buttons */}
      <div className="grid grid-cols-2 gap-4 mb-6">
        {/* Participant 1 Point Button */}
        <div className="bg-white rounded-xl shadow-lg p-6">
          <h3 className="font-bold text-gray-900 mb-4 text-center">
            {getParticipantName(participant1)}
          </h3>
          <button
            onClick={() => handleAddPoint(participant1Side)}
            className="w-full py-6 bg-gradient-to-r from-indigo-500 to-indigo-600 text-white font-bold text-xl rounded-lg hover:shadow-lg transition-all flex items-center justify-center gap-2"
          >
            <Trophy className="w-6 h-6" />
            POINT
          </button>
        </div>

        {/* Participant 2 Point Button */}
        <div className="bg-white rounded-xl shadow-lg p-6">
          <h3 className="font-bold text-gray-900 mb-4 text-center">
            {getParticipantName(participant2)}
          </h3>
          <button
            onClick={() => handleAddPoint(participant2Side)}
            className="w-full py-6 bg-gradient-to-r from-purple-500 to-purple-600 text-white font-bold text-xl rounded-lg hover:shadow-lg transition-all flex items-center justify-center gap-2"
          >
            <Trophy className="w-6 h-6" />
            POINT
          </button>
        </div>
      </div>

      {/* Server Toggle Section */}
      <div className="bg-yellow-50 border-2 border-yellow-300 rounded-lg p-4 mb-6">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-3">
            <span className="text-2xl">{getServingIcon(sport.name)}</span>
            <div>
              <div className="text-xs text-gray-600 font-medium">Current Server</div>
              <div className="text-lg font-bold text-gray-900">{getServerName()}</div>
            </div>
          </div>
          <button
            onClick={handleToggleServer}
            className="flex items-center gap-2 px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white rounded-lg font-semibold transition-colors shadow-md"
          >
            <RefreshCw className="w-4 h-4" />
            Switch Server
          </button>
        </div>

        {/* Doubles: Player Selection Within Pair */}
        {isDoublesMatch && (() => {
          const currentServerSide = liveScore?.server || 'participant1';
          // Always use original match details (not swapped) for player names
          const currentServerDetails = currentServerSide === 'participant1' 
            ? match.participant1_details 
            : match.participant2_details;
          
          if (!currentServerDetails || !currentServerDetails.player1 || !currentServerDetails.player2) {
            return null;
          }

          const servingPlayerId = liveScore?.serving_player_id;
          const player1Id = currentServerDetails.player1?.id;
          const player2Id = currentServerDetails.player2?.id;

          return (
            <div className="border-t border-yellow-300 pt-4">
              <div className="text-xs text-gray-600 font-medium mb-2">Who is serving in this pair?</div>
              <div className="flex gap-3">
                {/* Player 1 Button */}
                <button
                  onClick={() => handlePlayerSelect(player1Id)}
                  className={`flex-1 flex items-center justify-between p-3 rounded-lg border-2 transition-all ${
                    servingPlayerId === player1Id
                      ? 'bg-emerald-100 border-emerald-500 shadow-md'
                      : 'bg-white border-gray-300 hover:border-emerald-400'
                  }`}
                >
                  <div className="text-left">
                    <div className="font-bold text-gray-900 text-sm">
                      {currentServerDetails.player1.first_name} {currentServerDetails.player1.last_name}
                    </div>
                    <div className="text-xs text-gray-600">Player 1</div>
                  </div>
                  {servingPlayerId === player1Id && (
                    <span className="text-xl">{getServingIcon(sport.name)}</span>
                  )}
                </button>

                {/* Player 2 Button */}
                <button
                  onClick={() => handlePlayerSelect(player2Id)}
                  className={`flex-1 flex items-center justify-between p-3 rounded-lg border-2 transition-all ${
                    servingPlayerId === player2Id
                      ? 'bg-blue-100 border-blue-500 shadow-md'
                      : 'bg-white border-gray-300 hover:border-blue-400'
                  }`}
                >
                  <div className="text-left">
                    <div className="font-bold text-gray-900 text-sm">
                      {currentServerDetails.player2.first_name} {currentServerDetails.player2.last_name}
                    </div>
                    <div className="text-xs text-gray-600">Player 2</div>
                  </div>
                  {servingPlayerId === player2Id && (
                    <span className="text-xl">{getServingIcon(sport.name)}</span>
                  )}
                </button>
              </div>
            </div>
          );
        })()}
      </div>

      {/* Sport-Specific Info */}
      <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
        <div className="flex items-start gap-3">
          <Clock className="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" />
          <div className="text-sm text-blue-800">
            {isTennisStyle && (
              <p>
                <strong>Tennis Scoring:</strong> Points progress 0 → 15 → 30 → 40 → Game. 
                At 40-40 (Deuce), win by 2 points (Advantage required). First to 6 games wins the set (win by 2). 
                Tiebreak at 6-6. 🎾 indicates server.
              </p>
            )}
            {isRallyScoring && sport.name === 'Badminton' && (
              <p>
                <strong>Badminton Scoring:</strong> Rally point system. First to 21 points wins the set (win by 2, cap at 30). 
                Best of 3 sets. Interval at 11 points.
              </p>
            )}
            {isRallyScoring && sport.name === 'Pickleball' && (
              <p>
                <strong>Pickleball Scoring:</strong> Rally point system. First to 11 points wins the game (win by 2). 
                Best of 3 games.
              </p>
            )}
          </div>
        </div>
      </div>

      {/* Set/Game History */}
      {liveScore && (isTennisStyle || isBadminton ? liveScore.participant1?.set_scores : liveScore.participant1?.game_scores) && (
        <div className="bg-white rounded-xl shadow-lg p-6">
          <h3 className="font-bold text-gray-900 mb-4">
            {isTennisStyle || isBadminton ? 'Set History' : 'Game History'}
          </h3>
          <div className="flex justify-center gap-3">
            {(isTennisStyle || isBadminton ? liveScore.participant1.set_scores : liveScore.participant1.game_scores).map((p1Score, idx) => {
              const p2Score = (isTennisStyle || isBadminton ? liveScore.participant2.set_scores : liveScore.participant2.game_scores)[idx];
              const isCurrent = idx === getCurrentSetGame() - 1;
              
              return (
                <div
                  key={idx}
                  className={`px-4 py-2 rounded-lg font-bold ${
                    isCurrent
                      ? 'bg-indigo-100 text-indigo-700 border-2 border-indigo-500'
                      : 'bg-gray-100 text-gray-700'
                  }`}
                >
                  {isTennisStyle || isBadminton ? `Set ${idx + 1}` : `Game ${idx + 1}`}: {p1Score}-{p2Score}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Match End Confirmation Modal */}
      {showMatchEndConfirmation && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 animate-scale-in">
            <div className="text-center mb-6">
              <div className="w-20 h-20 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4">
                <AlertCircle className="w-12 h-12 text-white" />
              </div>
              <h2 className="text-2xl font-bold text-gray-900 mb-2">
                Confirm Match End?
              </h2>
              <p className="text-gray-600">
                This point would end the match. Do you want to declare the winner?
              </p>
              {liveScore?.pending_winner && (
                <div className="mt-4 p-4 bg-emerald-50 rounded-lg">
                  <p className="text-sm text-gray-700 mb-1">Winner:</p>
                  <p className="text-lg font-bold text-emerald-700">
                    {liveScore.pending_winner === 'participant1' 
                      ? getParticipantName(match.participant1_details)
                      : getParticipantName(match.participant2_details)
                    }
                  </p>
                </div>
              )}
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => handleConfirmMatchEnd(false)}
                disabled={confirmingMatchEnd}
                className="flex-1 px-6 py-3 bg-gray-200 text-gray-800 font-semibold rounded-lg hover:bg-gray-300 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
              >
                <XCircle className="w-5 h-5" />
                No, Undo Point
              </button>
              <button
                onClick={() => handleConfirmMatchEnd(true)}
                disabled={confirmingMatchEnd}
                className="flex-1 px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
              >
                {confirmingMatchEnd ? (
                  <>
                    <RefreshCw className="w-5 h-5 animate-spin" />
                    Confirming...
                  </>
                ) : (
                  <>
                    <CheckCircle className="w-5 h-5" />
                    Yes, End Match
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default SetBasedScoringInterface;
